rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email'])
        && data.keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['userId', 'nickname', 'level', 'xp', 'streak', 'olGrade', 'badgeTitle', 'avatarSeed'])
        && data.keys().hasOnly(['userId', 'nickname', 'level', 'xp', 'streak', 'olGrade', 'badgeTitle', 'avatarSeed', 'primarySubjectId', 'bio', 'unlockedBadges', 'friendIds', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.nickname is string
        && data.nickname.size() >= 2
        && data.nickname.size() <= 24
        && data.level is number
        && data.level >= 1
        && data.level <= 99
        && data.xp is number
        && data.xp >= 0
        && data.streak is number
        && data.streak >= 0
        && data.olGrade is string
        && data.olGrade.size() <= 32
        && data.badgeTitle is string
        && data.badgeTitle.size() <= 64
        && data.avatarSeed is string
        && data.avatarSeed.size() <= 4
        && (!('primarySubjectId' in data) || (data.primarySubjectId is string && data.primarySubjectId.size() <= 32))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 160))
        && (!('unlockedBadges' in data) || (data.unlockedBadges is list && data.unlockedBadges.size() <= 50))
        && (!('friendIds' in data) || (data.friendIds is list && data.friendIds.size() <= 200));
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['userId', 'themeMode', 'palette', 'accentColor'])
        && data.keys().hasOnly(['userId', 'themeMode', 'palette', 'accentColor', 'fontSize', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.themeMode in ['dark', 'light']
        && data.palette in ['monochrome', 'paper-ink', 'nordic-slate', 'high-contrast', 'warm-terminal']
        && data.accentColor is string
        && data.accentColor.size() <= 32;
    }

    function isValidStudyRoom(data) {
      return data.keys().hasAll(['roomId', 'subjectId', 'name', 'createdBy', 'creatorNickname'])
        && data.keys().hasOnly(['roomId', 'subjectId', 'name', 'topic', 'createdBy', 'creatorNickname', 'meetLink', 'pomodoroRemainingSeconds', 'isPomodoroActive', 'createdAt', 'updatedAt'])
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomId.size() <= 128
        && data.subjectId is string
        && data.subjectId.size() <= 32
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 64
        && data.createdBy == request.auth.uid
        && data.creatorNickname is string
        && data.creatorNickname.size() <= 24
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 100))
        && (!('meetLink' in data) || data.meetLink == null || (data.meetLink is string && data.meetLink.size() <= 200))
        && (!('pomodoroRemainingSeconds' in data) || (data.pomodoroRemainingSeconds is number && data.pomodoroRemainingSeconds >= 0))
        && (!('isPomodoroActive' in data) || data.isPomodoroActive is bool);
    }

    function isValidStudyMessage(data) {
      return data.keys().hasAll(['messageId', 'roomId', 'userId', 'nickname', 'text'])
        && data.keys().hasOnly(['messageId', 'roomId', 'userId', 'nickname', 'avatarSeed', 'text', 'attachmentUrl', 'createdAt'])
        && data.messageId is string
        && data.messageId.size() > 0
        && data.messageId.size() <= 128
        && data.roomId is string
        && data.roomId.size() <= 128
        && data.userId == request.auth.uid
        && data.nickname is string
        && data.nickname.size() <= 24
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 1000
        && (!('avatarSeed' in data) || (data.avatarSeed is string && data.avatarSeed.size() <= 4))
        && (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 500000));
    }

    // Collection: Users (Isolated private PII data)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Deny query scraping of private emails
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Collection: Public Profiles (Level-based leaderboard & friend search for O/L students)
    match /publicProfiles/{userId} {
      allow get, list: if true; // Public leaderboard and friend dossier visibility
      allow create: if isOwner(userId) && isValidId(userId) && isValidPublicProfile(incoming());
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'level', 'xp', 'streak', 'olGrade', 'badgeTitle', 'avatarSeed', 'primarySubjectId', 'bio', 'unlockedBadges', 'friendIds', 'updatedAt']);
      allow delete: if false;
    }

    // Collection: User Settings (Custom webpage & GUI appearance)
    match /userSettings/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserSettings(incoming());
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserSettings(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['themeMode', 'palette', 'accentColor', 'fontSize', 'updatedAt']);
      allow delete: if false;
    }

    // Collection: Study Rooms (Subject study spaces with Google Meet integration)
    match /studyRooms/{roomId} {
      allow get, list: if isSignedIn() && isValidId(roomId);
      allow create: if isSignedIn() && isValidId(roomId) && isValidStudyRoom(incoming());
      allow update: if isSignedIn() && isValidId(roomId) && isValidStudyRoom(incoming());
      allow delete: if isSignedIn() && isValidId(roomId) && resource.data.createdBy == request.auth.uid;

      // Subcollection: Study Room Discussion Messages & Homework Pictures
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(messageId);
        allow create: if isSignedIn() && isValidId(messageId) && isValidStudyMessage(incoming());
        allow update, delete: if isSignedIn() && isValidId(messageId) && resource.data.userId == request.auth.uid;
      }
    }
  }
}
